{
  "realm": "test-platform",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "clientScopes": [
    {
      "name": "platform.read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      },
      "protocolMappers": [
        {
          "name": "platform-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "platform-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "platform.write",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      },
      "protocolMappers": []
    }
  ],
  "clients": [
    {
      "clientId": "platform-cli",
      "enabled": true,
      "publicClient": false,
      "secret": "${PLATFORM_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": [
        "platform.read",
        "platform.write"
      ]
    }
  ],
  "users": []
}
